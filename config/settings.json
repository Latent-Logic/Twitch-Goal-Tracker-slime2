{
	"text-values": {
		"label": "Text",
		"settings": {
			"title-toggle": {
				"type": "toggle-input",
				"label": "Show Title?",
				"halfSpan": true,
				"defaultValue": false
			},
			"bar-text-title": {
				"type": "text-input",
				"label": "Bar Title Text",
				"halfSpan": true
			},
			"text-above-toggle": {
				"type": "toggle-input",
				"label": "Show Text Above?",
				"halfSpan": true,
				"defaultValue": false
			},
			"text-above-bar": {
				"type": "text-input",
				"label": "Text above bar",
				"halfSpan": true
			},
			"text-below-toggle": {
				"type": "toggle-input",
				"label": "Show Text Below?",
				"halfSpan": true,
				"defaultValue": false
			},
			"text-below-bar": {
				"type": "text-input",
				"label": "Text below bar",
				"halfSpan": true
			}
		}
	},
	"bar-settings": {
		"label": "Bar Settings",
		"settings": {
			"bar-type": {
				"type": "dropdown-input",
				"label": "Progress Bar Type",
				"defaultValue": "bar-milestone",
				"options": [
					{
						"label": "Donation Goal",
						"value": "bar-goal"
					},
					{
						"label": "Milestone Goals",
						"value": "bar-milestone"
					}
				]
			},
			"milestone-list": {
				"type": "text-area-input",
				"label": "Milestone List",
				"condition": {
					"bar-type": [
						"bar-milestone"
					]
				},
				"defaultValue": "500, milestone",
				"placeholder": "number, text"
			},
			"rescale-bar-toggle": {
				"type": "toggle-input",
				"label": "Rescale Bar?",
				"halfSpan": true,
				"defaultValue": true
			},
			"offset-amount": {
				"type": "number-input",
				"label": "Offset Amount",
				"condition": {
					"bar-type": [
						"bar-goal"
					]
				},
				"halfSpan": true,
				"defaultValue": 100,
				"min": 0,
				"placeholder": "$ amount"
			}
		}
	},
	"example-category": {
		"label": "Websocket",
		"settings": {
			"wss-url": {
				"type": "text-input",
				"label": "Websocket URL",
				"condition": {},
				"placeholder": "wss://",
				"description": "Target address for the websocket listener. This will establish a websocket connection that'll update whenever a donation event is received from the bot server."
			},
			"server-connect": {
				"type": "toggle-input",
				"label": "Connect to server",
				"halfSpan": true,
				"defaultValue": false,
				"description": "Toggles whether to try to connect to the websocket. If false, you'll be able to set an placeholder amount for testing."
			},
			"ws-reconnect": {
				"type": "button",
				"label": "Reconnect",
				"halfSpan": true
			},
			"server-info": {
				"type": "text-display",
				"label": "This will try to establish a websocket connection when the page first loads, but shouldn't keep trying whenever you change you change values. If you aren't seeing the amount value update, Inspect page in your browser to see if there are connection issues"
			},
			"goal-heading": {
				"type": "heading",
				"label": "Goal Bar Values"
			},
			"goal": {
				"type": "number-input",
				"label": "Goal",
				"halfSpan": true,
				"defaultValue": 1000,
				"min": 0,
				"placeholder": "Goal $ amount",
				"description": "Goal of donation bar"
			},
			"test-amount-val": {
				"type": "number-input",
				"label": "Placeholder amount",
				"condition": {},
				"halfSpan": true,
				"defaultValue": 500,
				"min": 0,
				"placeholder": "$ amount",
				"description": "Uses this as the current amount raised when the server is not connected"
			}
		}
	},
	"bar-style": {
		"label": "Bar Appearance",
		"settings": {
			"bar-height": {
				"type": "number-input",
				"label": "Bar Height",
				"defaultValue": 25,
				"min": 0
			},
			"bar-width": {
				"type": "number-input",
				"label": "Bar Width",
				"defaultValue": 500,
				"min": 0
			},
			"bar-border-size": {
				"type": "slider-input",
				"label": "Bar Border Thickness",
				"defaultValue": 0,
				"min": 0,
				"max": 15,
				"step": 1
			},
			"bar-border-color": {
				"type": "color-input",
				"label": "Bar Border Color",
				"defaultValue": "#fff"
			},
			"bar-fill-color": {
				"type": "color-input",
				"label": "Bar Fill Colour",
				"defaultValue": "#de4646"
			},
			"bar-color": {
				"type": "color-input",
				"label": "Bar Color Background",
				"defaultValue": "#6262628a"
			},
			"border-radius": {
				"type": "slider-input",
				"label": "Border Radius",
				"defaultValue": 0,
				"min": 0,
				"max": 50,
				"step": 1
			}
		}
	},
	"font-settings": {
		"label": "Text Settings",
		"settings": {
			"font-name": {
				"type": "font-input",
				"label": "Font",
				"defaultValue": "Inter",
				"placeholder": "Font name"
			},
			"font-weight": {
				"type": "dropdown-input",
				"label": "Font Weight",
				"condition": {},
				"halfSpan": true,
				"defaultValue": 400,
				"options": [
					{
						"label": "Thin",
						"value": 100
					},
					{
						"label": "Extra-Light",
						"value": 200
					},
					{
						"label": "Light",
						"value": 300
					},
					{
						"label": "Normal",
						"value": 400
					},
					{
						"label": "Medium",
						"value": 500
					},
					{
						"label": "Semi-Bold",
						"value": 600
					},
					{
						"label": "Bold",
						"value": 700
					},
					{
						"label": "Extra-Bold",
						"value": 800
					},
					{
						"label": "Heavy",
						"value": 900
					}
				]
			},
			"font-size": {
				"type": "slider-input",
				"label": "Font Size (px)",
				"halfSpan": true,
				"defaultValue": 14,
				"min": 1,
				"max": 72,
				"step": 1
			},
			"text-color": {
				"type": "color-input",
				"label": "Font Color",
				"halfSpan": true,
				"defaultValue": "#fff"
			},
			"text-background-color": {
				"type": "color-input",
				"label": "Background Color",
				"defaultValue": "#fff0"
			},
			"text-background-border-radius": {
				"type": "slider-input",
				"label": "Background Radius",
				"halfSpan": true,
				"defaultValue": 0,
				"min": 0,
				"max": 50,
				"step": 1
			}
		}
	}
}